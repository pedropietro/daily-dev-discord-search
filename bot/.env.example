# --- Discord (https://discord.com/developers/applications)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: register commands in one server (instant). Empty = global (can take up to 1h).
DISCORD_GUILD_ID=

# --- daily.dev OAuth app (daily.dev > Settings > API > OAuth apps > Create app)
# Register this exact redirect URI on the app: ${PUBLIC_BASE_URL}/oauth/callback
DAILY_DEV_CLIENT_ID=
DAILY_DEV_CLIENT_SECRET=

# Public HTTPS URL where this bot's HTTP server is reachable (no trailing slash)
PUBLIC_BASE_URL=https://dailydev-bot.example.com
PORT=3000

# --- Token storage: per-user tokens are encrypted with AES-256-GCM
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
DATA_DIR=./data

# --- Optional behaviour
DEFAULT_RESULTS=5
DEFAULT_PERIOD=month
# Tag suggestions while typing spend the user's own quota (free tier: 200 requests/month). Off by default.
ENABLE_TAG_AUTOCOMPLETE=false
TAG_AUTOCOMPLETE_MIN_LENGTH=3
TAG_AUTOCOMPLETE_DEBOUNCE_MS=700
