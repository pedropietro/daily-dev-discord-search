# Discord — https://discord.com/developers/applications
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: register commands in a single server (instant). Leave empty for global commands (can take up to 1h).
DISCORD_GUILD_ID=

# daily.dev personal access token — https://daily.dev/settings/api
# Only ever sent to api.daily.dev.
DAILY_DEV_TOKEN=

# Optional defaults
DEFAULT_RESULTS=5
DEFAULT_PERIOD=month
